{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/(ghost-jungle|user-data|meta|portrait)",
      "destination": "/api/$1.js"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/public/$1"
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Access-Control-Allow-Methods",
          "value": "GET,OPTIONS"
        }
      ]
    }
  ],
  "functions": {
    "api/*.js": {
      "includeFiles": "assets/fonts/**"
    }
  }
}
