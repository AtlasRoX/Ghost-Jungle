{
  "name": "github-ghost-jungle",
  "version": "1.0.0",
  "description": "An animated GitHub profile README where every repository becomes an evolving ghost spirit in a cinematic moonlit jungle.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "cli": "node src/cli.js",
    "test": "node test/test-render.js",
    "og": "node scripts/build-og.js"
  },
  "keywords": [
    "github-readme",
    "github-profile",
    "profile-readme",
    "readme-widget",
    "animated-svg",
    "github-stats",
    "svg",
    "ghost",
    "interactive"
  ],
  "author": "AtlasRoX",
  "license": "MIT",
  "dependencies": {
    "express": "^4.21.2"
  },
  "homepage": "https://ghost-jungle.vercel.app",
  "repository": {
    "type": "git",
    "url": "https://github.com/AtlasRoX/Ghost-Jungle.git"
  },
  "bin": {
    "ghost-jungle": "src/cli.js"
  }
}
